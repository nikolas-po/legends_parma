  <property name="windowTitle">
   <string>SettingsAPI_Window</string>
  </property>
  <property name="styleSheet">
   <string notr="true">#centralwidget { background-color: #F5F0E8; }
#headerFrame { background-color: #2C2A26; border: none; }
#headerFrame QLabel { color: #F5F0E8; }
#logout_btn { background-color: transparent; color: #F5F0E8; border: 1px solid rgba(255, 255, 255, 0.25); padding: 3px 10px; font-size: 12px; border-radius: 4px; }
#logout_btn:hover { background-color: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.4); }
#logout_btn:pressed { background-color: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.5); }
#logout_btn:focus { border: 1px dashed #F5F0E8; }

#contentFrame { background-color: #F5F0E8; }
#leftPanel, #rightPanel { background-color: #FFFFFF; border: 1px solid #D4CBBE; border-radius: 4px; }
#title_cache, #title_api { font-size: 14px; font-weight: 600; color: #2C2A26; }
#lbl_ttl, #lbl_api_key, #lbl_osm, #lbl_timeout { font-size: 12px; color: #6B6560; }
#lbl_stats { font-size: 12px; color: #6B6560; }

QLineEdit, QSpinBox {
    padding: 10px 12px; font-size: 14px; border-radius: 4px; border: 1px solid #D4CBBE; background-color: #FFFFFF; color: #2C2A26;
}
QLineEdit:hover, QSpinBox:hover { border: 1px solid #B8AE9E; }
QLineEdit:focus, QSpinBox:focus { border: 1px solid #4A6741; }
QLineEdit[error="true"], QSpinBox[error="true"] { border: 1px solid #B54A3A; }
QLineEdit:disabled, QSpinBox:disabled { border: 1px dashed #D4CBBE; color: #A39E94; background-color: #F5F0E8; }

#btn_clear_cache { background-color: #FFFFFF; color: #B54A3A; border: 1px solid #B54A3A; padding: 11px 16px; font-size: 14px; border-radius: 4px; }
#btn_clear_cache:hover { background-color: #F5E8E6; }
#btn_clear_cache:pressed { background-color: #EBD5D1; }
#btn_clear_cache:disabled { background-color: #FFFFFF; color: #D4A39C; border: 1px solid #E5C4BF; }
#btn_clear_cache:focus { border: 1px dashed #4A6741; }

#btn_save_cache, #btn_check_conn { background-color: #FFFFFF; color: #2C2A26; border: 1px solid #D4CBBE; padding: 11px 16px; font-size: 14px; border-radius: 4px; }
#btn_save_cache:hover, #btn_check_conn:hover { border: 1px solid #4A6741; background-color: #F5F0E8; }
#btn_save_cache:pressed, #btn_check_conn:pressed { background-color: #EDE6D9; }
#btn_save_cache:disabled, #btn_check_conn:disabled { background-color: #FFFFFF; color: #A39E94; border: 1px solid #E5DFD4; }
#btn_save_cache:focus, #btn_check_conn:focus { border: 1px dashed #4A6741; }

#btn_save_api { background-color: #4A6741; color: #FFFFFF; border: none; padding: 11px 16px; font-size: 14px; font-weight: 600; border-radius: 4px; }
#btn_save_api:hover { background-color: #3D5636; }
#btn_save_api:pressed { background-color: #334A2E; }
#btn_save_api:disabled { background-color: #A8B5A0; }
#btn_save_api:focus { border: 1px dashed #4A6741; }

QTabWidget::panel { border: none; background-color: #FFFFFF; }
QTabBar { background-color: #FFFFFF; border: none; }
QTabBar::tab { height: 40px; background-color: #FFFFFF; color: #6B6560; font-size: 12px; font-weight: normal; padding: 0px 30px; border: none; border-bottom: 2px solid transparent; border-top: 1px solid #D4CBBE; text-align: center; }
QTabBar::tab:hover { color: #2C2A26; }
QTabBar::tab:selected { color: #2C2A26; font-weight: 600; border-bottom: 2px solid #4A6741; }</string>
