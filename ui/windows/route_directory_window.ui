   </rect>
  </property>
  <property name="windowTitle">
   <string>RouteCatalogWindow</string>
  </property>
  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-color: #F5F0E8;
}

#headerFrame {
    background-color: #2C2A26;
    border-bottom: 1px solid rgba(255,255,255,0.2);
}
#headerFrame QLabel {
    color: #F5F0E8;
    border: none;
}
#logout_btn {
    background-color: transparent;
    color: #F5F0E8;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 3px 10px;
    font-size: 12px;
    border-radius: 4px;
}
#logout_btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.4);
}
#logout_btn:pressed {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.5);
}

#leftPanel {
    background-color: #F5F0E8;
    border-right: 1px solid #D4CBBE;
}
#lbl_title { font-size: 12px; color: #6B6560; }
#lbl_desc { font-size: 11px; color: #6B6560; }

#btn_open {
    background-color: #4A6741;
    color: #FFFFFF;
    border: none;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_open:hover { background-color: #3D5636; }
#btn_open:pressed { background-color: #334A2E; }
#btn_open:disabled { background-color: #A8B5A0; }

#btn_edit {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_edit:hover { background-color: #F5F0E8; border: 1px solid #4A6741; }
#btn_edit:pressed { background-color: #EDE6D9; border: 1px solid #3D5636; }
#btn_edit:disabled { background-color: #FFFFFF; color: #A39E94; border: 1px solid #E5DFD4; }

#btn_delete {
    background-color: #FFFFFF;
    color: #B54A3A;
    border: 1px solid #B54A3A;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_delete:hover { background-color: #F5E8E6; color: #B54A3A; border: 1px solid #B54A3A; }
#btn_delete:pressed { background-color: #EBD5D1; color: #9A3E30; border: 1px solid #9A3E30; }
#btn_delete:disabled { background-color: #FFFFFF; color: #D4A39C; border: 1px solid #E5C4BF; }

QRadioButton { spacing: 6px; font-size: 12px; color: #6B6560; }
QRadioButton::indicator { width: 15px; height: 15px; }
QRadioButton::indicator:unchecked { border: 1px solid #D4CBBE; border-radius: 8px; background-color: #FFFFFF; }
QRadioButton::indicator:checked { border: 4px solid #4A6741; border-radius: 8px; background-color: #FFFFFF; }

#rightPanel { background-color: #F5F0E8; }

#offlineBanner {
    background-color: #F0EEEA;
    border: 1px solid #D4CBBE;
    border-radius: 4px;
}
#offlineBanner QLabel {
    font-size: 12px;
    color: #6B6560;
}
#offlineDot {
    background-color: #A39E94;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

#filterPanel {
    background-color: #F5F0E8;
    border-top: 1px solid #D4CBBE;
}
#filterPanel QLineEdit {
    padding: 4px 8px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
}
#filterPanel QLineEdit:hover { border: 1px solid #B8AE9E; }
#filterPanel QLineEdit:focus { border: 1px solid #4A6741; }
#filterPanel QLineEdit[error="true"] { border: 1px solid #B54A3A; }
#filterPanel QLineEdit:disabled { border: 1px dashed #D4CBBE; color: #A39E94; background-color: #F5F0E8; }
#filterPanel QLineEdit#searchInput { min-width: 160px; max-width: 240px; }

#filterPanel QComboBox {
    padding: 4px 8px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
    min-width: 120px;
}
#filterPanel QComboBox:hover { border: 1px solid #B8AE9E; }
#filterPanel QComboBox:on { border: 1px solid #4A6741; }
#filterPanel QComboBox:disabled { border: 1px dashed #D4CBBE; color: #A39E94; background-color: #F5F0E8; }
#filterPanel QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4CBBE;
    selection-background-color: #E8EDE4;
    selection-color: #2C2A26;
}
#filterPanel QComboBox QAbstractItemView::item:hover { background-color: #EDE6D9; }

#btn_add_route {
    background-color: #4A6741;
    color: #FFFFFF;
    border: none;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_add_route:hover { background-color: #3D5636; }
#btn_add_route:pressed { background-color: #334A2E; }
#btn_add_route:disabled { background-color: #A8B5A0; }
#btn_add_route:focus { border: 1px dashed #4A6741; }

#btn_reset {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_reset:hover { background-color: #F5F0E8; border: 1px solid #4A6741; }
#btn_reset:pressed { background-color: #EDE6D9; border: 1px solid #3D5636; }
#btn_reset:disabled { background-color: #FFFFFF; color: #A39E94; border: 1px solid #E5DFD4; }
#btn_reset:focus { border: 1px dashed #4A6741; }

#chk_deleted {
    spacing: 6px;
    font-size: 12px;
    color: #6B6560;
}
#chk_deleted::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
}
#chk_deleted::indicator:hover { border: 1px solid #B8AE9E; }
#chk_deleted::indicator:checked { background-color: #4A6741; border: 1px solid #4A6741; }
#chk_deleted::indicator:pressed { background-color: #334A2E; border: 1px solid #334A2E; }
#chk_deleted::indicator:disabled { background-color: #E5DFD4; border: 1px solid #E5DFD4; }
#chk_deleted:disabled { color: #A39E94; }

#tableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAF8F3;
    border: 1px solid #D4CBBE;
    outline: none;
}
QHeaderView::section {
    font-size: 11px;
    font-weight: 600;
    color: #6B6560;
    background-color: #EDE6D9;
    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #D4CBBE;
    border-right: 1px solid #D4CBBE;
}
QTableWidget::item {
    font-size: 12px;
    color: #2C2A26;
    padding: 7px 10px;
    border-bottom: 1px solid #D4CBBE;
}
QTableWidget::item:hover { background-color: #EDE6D9; }
QTableWidget::item:selected { background-color: #E8EDE4; color: #2C2A26; }
#footerLabel { font-size: 11px; color: #6B6560; }

#lblLoadingTitle {
    font-size: 14px;
    color: #6B6560;
}
#lblLoadingSub {
    font-size: 12px;
    color: #A39E94;
}
#lblEmptyTitle {
    font-size: 14px;
    color: #6B6560;
}
#lblEmptySub {
    font-size: 12px;
    color: #A39E94;
}
#errorFrame {
    background-color: #FFFFFF;
    border: 1px solid #B54A3A;
    border-radius: 4px;
}
#errorFrame QLabel {
    font-size: 14px;
    color: #B54A3A;
}
#btnRetry {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 12px;
}
#btnRetry:hover {
    border: 1px solid #4A6741;
    background-color: #F5F0E8;
}

QTabWidget::panel { border: none; background-color: #FFFFFF; }
QTabBar { background-color: #FFFFFF; border: none; }
QTabBar::tab { 
    height: 40px; 
    background-color: #FFFFFF; 
    color: #6B6560; 
    font-size: 12px; 
    font-weight: normal; 
    padding: 0px 30px; 
    border: none; 
    border-bottom: 2px solid transparent; 
    border-top: 1px solid #D4CBBE;
    text-align: center; 
}
QTabBar::tab:hover { color: #2C2A26; }
QTabBar::tab:selected { color: #2C2A26; font-weight: 600; border-bottom: 2px solid #4A6741; }</string>
