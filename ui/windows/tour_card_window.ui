  <property name="styleSheet">
   <string notr="true">#centralwidget { background-color: #F5F0E8; }
#headerFrame { background-color: #2C2A26; border-bottom: 1px solid rgba(255,255,255,0.2); }
#headerFrame QLabel { color: #F5F0E8; border: none; }
#logout_btn { background-color: transparent; color: #F5F0E8; border: 1px solid rgba(255, 255, 255, 0.25); padding: 3px 10px; font-size: 12px; border-radius: 4px; }
#logout_btn:hover { background-color: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.4); }
#logout_btn:pressed { background-color: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.5); }
#logout_btn:focus { border: 1px dashed #F5F0E8; }

#toolbarFrame { background-color: #FFFFFF; border-bottom: 1px solid #D4CBBE; }
#btn_back { padding: 3px 9px; font-size: 12px; color: #6B6560; background: transparent; border: none; }
#btn_back:hover { background: #F5F0E8; color: #2C2A26; }
#lbl_toolbar_title { font-size: 14px; font-weight: 600; color: #2C2A26; margin-left: 8px; }
#btn_change_status, #btn_edit { background: #FFFFFF; color: #2C2A26; border: 1px solid #D4CBBE; padding: 4px 10px; font-size: 12px; border-radius: 4px; }
#btn_change_status:hover, #btn_edit:hover { background: #F5F0E8; border: 1px solid #4A6741; }

#leftPanel { background-color: #F5F0E8; }
#rightPanel { background-color: #FFFFFF; border-left: 1px solid #D4CBBE; }

#lbl_main_title { font-size: 18px; font-weight: 600; color: #2C2A26; }
#lbl_meta { font-size: 12px; color: #6B6560; }

#routesFrame, #descFrame { background-color: #FFFFFF; border: 1px solid #D4CBBE; border-radius: 4px; }
QLabel[styleClass="sectionTitle"] { font-size: 11px; font-weight: 600; color: #6B6560; margin-bottom: 8px; }
#lbl_desc_text { font-size: 13px; color: #2C2A26; }

QTableWidget { background-color: #FFFFFF; border: none; outline: none; gridline-color: #D4CBBE; }
QHeaderView::section { background-color: #EDE6D9; color: #6B6560; font-size: 11px; font-weight: 600; border: none; border-bottom: 1px solid #D4CBBE; border-right: 1px solid #D4CBBE; padding: 7px 10px; text-align: left; }
QTableWidget::item { border-bottom: 1px solid #D4CBBE; padding: 7px 10px; color: #2C2A26; font-size: 12px; }
QTableWidget::item:hover { background-color: #EDE6D9; }
QTableWidget::item:selected { background-color: #E8EDE4; color: #2C2A26; }
QTableWidget QPushButton { background-color: #FFFFFF; color: #2C2A26; border: 1px solid #D4CBBE; border-radius: 4px; padding: 3px 9px; font-size: 12px; }
QTableWidget QPushButton:hover { border: 1px solid #4A6741; background-color: #F5F0E8; }

QLabel[styleClass="statLabel"] { font-size: 11px; color: #6B6560; }
QLabel[styleClass="statValue"] { font-size: 13px; color: #2C2A26; }
#lbl_status_badge { font-size: 12px; color: #4A6741; background-color: #E8EDE4; border: 1px solid #4A6741; padding: 2px 8px; border-radius: 3px; }

#btn_cancel_tour { background-color: #FFFFFF; color: #B54A3A; border: 1px solid #B54A3A; padding: 6px 12px; font-size: 13px; border-radius: 4px; font-weight: 600; }
#btn_cancel_tour:hover { background-color: #F5E8E6; }

QTabWidget::panel { border: none; background-color: #FFFFFF; }
QTabBar { background-color: #FFFFFF; border: none; }
QTabBar::tab { height: 40px; background-color: #FFFFFF; color: #6B6560; font-size: 12px; font-weight: normal; padding: 0px 30px; border: none; border-bottom: 2px solid transparent; border-top: 1px solid #D4CBBE; text-align: center; }
QTabBar::tab:hover { color: #2C2A26; }
QTabBar::tab:selected { color: #2C2A26; font-weight: 600; border-bottom: 2px solid #4A6741; }</string>
