       <item>
        <widget class="QFrame" name="rightPanel">
         <property name="styleSheet">
          <string notr="true">#rightPanel { background-color: #F5F0E8; }
#filterPanel {
    background-color: #F5F0E8;
    border-top: 1px solid #D4CBBE;
}

#filterPanel QLineEdit {
    padding: 4px 8px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
}
#filterPanel QLineEdit:hover { border: 1px solid #B8AE9E; }
#filterPanel QLineEdit:focus { border: 1px solid #4A6741; }
#filterPanel QLineEdit#searchInput { min-width: 160px; max-width: 240px; }

#filterPanel QComboBox {
    padding: 4px 8px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
    min-width: 120px;
}
#filterPanel QComboBox:hover { border: 1px solid #B8AE9E; }
#filterPanel QComboBox:on { border: 1px solid #4A6741; }
#filterPanel QComboBox:disabled { background-color: #F5F0E8; color: #A39E94; border: 1px solid #E5DFD4; }
#filterPanel QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4CBBE;
    selection-background-color: #E8EDE4;
    selection-color: #2C2A26;
}
#filterPanel QComboBox QAbstractItemView::item:hover {
    background-color: #EDE6D9;
}

#btn_add_route {
    background-color: #4A6741;
    color: #FFFFFF;
    border: none;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_add_route:hover { background-color: #3D5636; }
#btn_add_route:pressed { background-color: #334A2E; }
#btn_add_route:disabled { background-color: #A8B5A0; }

#btn_reset {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_reset:hover { background-color: #F5F0E8; border: 1px solid #4A6741; }
#btn_reset:pressed { background-color: #EDE6D9; border: 1px solid #3D5636; }
#btn_reset:disabled { background-color: #FFFFFF; color: #A39E94; border: 1px solid #E5DFD4; }

#chk_deleted {
    spacing: 6px;
    font-size: 12px;
    color: #6B6560;
}
#chk_deleted::indicator {
    width: 15px;
    height: 15px;
    border-radius: 3px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
}
#chk_deleted::indicator:hover {
    border: 1px solid #B8AE9E;
}
#chk_deleted::indicator:checked {
    background-color: #4A6741;
    border: 1px solid #4A6741;
}
#chk_deleted::indicator:pressed {
    background-color: #334A2E;
    border: 1px solid #334A2E;
}
#chk_deleted::indicator:disabled {
    background-color: #E5DFD4;
    border: 1px solid #E5DFD4;
}
#chk_deleted:disabled {
    color: #A39E94;
}

#tableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAF8F3;
    border: 1px solid #D4CBBE;
    outline: none;
}
QHeaderView::section {
    font-size: 11px;
    font-weight: 600;
    color: #6B6560;
    background-color: #EDE6D9;
    padding: 7px 10px;
    border: none;
    border-bottom: 1px solid #D4CBBE;
