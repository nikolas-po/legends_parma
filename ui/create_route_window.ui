  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-color: #F5F0E8;
}

#headerFrame { 
    background-color: #2C2A26; 
    border: none; 
}
#headerFrame QLabel { 
    color: #F5F0E8; 
}
#logout_btn {
    background-color: transparent;
    color: #F5F0E8;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 3px 10px;
    font-size: 12px;
    border-radius: 4px;
}
#logout_btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.4);
}
#logout_btn:pressed {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.5);
}

#formContainer {
    background-color: #F5F0E8;
}
#btn_back {
    font-size: 12px;
    color: #6B6560;
    background: transparent;
    border: none;
    text-align: left;
    padding: 4px 8px;
    border-radius: 4px;
}
#btn_back:hover {
    background: #EDE6D9;
}
#lbl_form_title {
    font-size: 16px;
    font-weight: 600;
    color: #2C2A26;
}

#leftFormCard, #rightFormCard {
    background-color: #FFFFFF;
    border: 1px solid #D4CBBE;
    padding: 14px;
}
#sectionTitle {
    font-size: 11px;
    font-weight: 600;
    color: #6B6560;
    text-transform: uppercase;
}
#hintLabel {
    font-size: 11px;
    color: #A39E94;
}
#fieldLabel {
    font-size: 12px;
    color: #6B6560;
}
#listTitle {
    font-size: 14px;
    font-weight: 600;
    color: #2C2A26;
}

QLineEdit, QTextEdit, QComboBox {
    padding: 10px 12px;
    font-size: 14px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
}
QLineEdit:hover, QTextEdit:hover, QComboBox:hover {
    border: 1px solid #B8AE9E;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid #4A6741;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4CBBE;
    selection-background-color: #E8EDE4;
    selection-color: #2C2A26;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #EDE6D9;
}

#btn_add_point {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_add_point:hover {
    border: 1px solid #4A6741;
}

#btn_save {
    background-color: #4A6741;
    color: #FFFFFF;
    border: none;
    padding: 11px 16px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
}
#btn_save:hover { background-color: #3D5636; }
#btn_save:pressed { background-color: #334A2E; }
#btn_save:disabled { background-color: #A8B5A0; }

#btn_cancel {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    padding: 11px 16px;
    font-size: 14px;
    font-weight: 600;
    border-radius: 4px;
}
#btn_cancel:hover {
    background-color: #F5F0E8;
    border: 1px solid #4A6741;
}

#actionBar {
    border-top: 1px solid #D4CBBE;
}

QTabWidget::panel { border: none; background-color: #FFFFFF; }
QTabBar { background-color: #FFFFFF; border: none; }
QTabBar::tab { 
    height: 40px; 
    background-color: #FFFFFF; 
    color: #6B6560; 
    font-size: 12px; 
    font-weight: normal; 
    padding: 0px 30px; 
    border: none; 
    border-bottom: 2px solid transparent; 
    border-top: 1px solid #D4CBBE;
    text-align: center; 
}
QTabBar::tab:hover { color: #2C2A26; }
QTabBar::tab:selected { color: #2C2A26; font-weight: 600; border-bottom: 2px solid #4A6741; }</string>
