  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-color: #F5F0E8;
}

#headerFrame { 
    background-color: #2C2A26; 
    border: none; 
}
#headerFrame QLabel { 
    color: #F5F0E8; 
}
#logout_btn {
    background-color: transparent;
    color: #F5F0E8;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 3px 10px;
    font-size: 12px;
    border-radius: 4px;
}
#logout_btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.4);
}
#logout_btn:pressed {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.5);
}

#leftPanel {
    background-color: #FFFFFF;
    border-right: 1px solid #D4CBBE;
}
#lbl_selected_title {
    font-size: 14px;
    font-weight: 600;
    color: #2C2A26;
}
#lbl_selected_desc {
    font-size: 12px;
    color: #6B6560;
}

#btn_open_left {
    background-color: #4A6741;
    color: #FFFFFF;
    border: none;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_open_left:hover { background-color: #3D5636; }
#btn_open_left:pressed { background-color: #334A2E; }

#btn_edit_left {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_edit_left:hover { background-color: #F5F0E8; border: 1px solid #4A6741; }

#rightPanel {
    background-color: #FFFFFF;
}

QTableWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAF8F3;
    border: none;
    outline: none;
}
QHeaderView::section {
    background-color: #EDE6D9;
    color: #6B6560;
    font-size: 11px;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #D4CBBE;
    padding: 7px 10px;
    text-align: left;
}
QTableWidget::item {
    border-bottom: 1px solid #D4CBBE;
    padding: 7px 10px;
    color: #2C2A26;
    font-size: 12px;
}
QTableWidget::item:hover {
    background-color: #EDE6D9;
}
QTableWidget::item:selected {
    background-color: #E8EDE4;
    color: #2C2A26;
}

QTableWidget QPushButton {
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    border-radius: 4px;
    padding: 3px 9px;
    font-size: 12px;
}
QTableWidget QPushButton:hover {
    background-color: #F5F0E8;
    border: 1px solid #4A6741;
}

#searchInput {
    padding: 4px 8px;
    font-size: 12px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
    min-width: 160px;
    max-width: 240px;
}
#searchInput:hover { border: 1px solid #B8AE9E; }
#searchInput:focus { border: 1px solid #4A6741; }

#btn_new_tour {
    background-color: #4A6741;
    color: #FFFFFF;
    border: none;
    padding: 3px 9px;
    font-size: 12px;
    border-radius: 4px;
}
#btn_new_tour:hover { background-color: #3D5636; }
#btn_new_tour:pressed { background-color: #334A2E; }

QTabWidget::panel { border: none; background-color: #FFFFFF; }
QTabBar { background-color: #FFFFFF; border: none; }
QTabBar::tab { 
    height: 40px; 
    background-color: #FFFFFF; 
    color: #6B6560; 
    font-size: 12px; 
    font-weight: normal; 
    padding: 0px 30px; 
    border: none; 
    border-bottom: 2px solid transparent; 
    border-top: 1px solid #D4CBBE;
    text-align: center; 
}
QTabBar::tab:hover { color: #2C2A26; }
QTabBar::tab:selected { color: #2C2A26; font-weight: 600; border-bottom: 2px solid #4A6741; }</string>
