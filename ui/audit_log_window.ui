  <property name="styleSheet">
   <string notr="true">#centralwidget {
    background-color: #F5F0E8;
}

#headerFrame { 
    background-color: #2C2A26; 
    border: none; 
}
#headerFrame QLabel { 
    color: #F5F0E8; 
}
#logout_btn {
    background-color: transparent;
    color: #F5F0E8;
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 3px 10px;
    font-size: 12px;
    border-radius: 4px;
}
#logout_btn:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.4);
}
#logout_btn:pressed {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.5);
}

#contentFrame {
    background-color: #F5F0E8;
}

QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #D4CBBE;
    outline: none;
    gridline-color: transparent;
}
QHeaderView::section {
    background-color: #EDE6D9;
    color: #6B6560;
    font-size: 11px;
    font-weight: 600;
    border: none;
    border-bottom: 1px solid #D4CBBE;
    border-right: 1px solid #D4CBBE;
    padding: 7px 10px;
    text-align: left;
}
QTableWidget::item {
    border-bottom: 1px solid #D4CBBE;
    padding: 7px 10px;
    color: #2C2A26;
    font-size: 12px;
}
QTableWidget::item:hover {
    background-color: #EDE6D9;
}
QTableWidget::item:selected {
    background-color: #E8EDE4;
    color: #2C2A26;
}

#filterFrame {
    background-color: transparent;
}
#filterFrame QLabel {
    font-size: 13px;
    font-weight: 500;
    color: #6B6560;
}

QDateEdit, QComboBox {
    padding: 8px 12px;
    font-size: 13px;
    border-radius: 4px;
    border: 1px solid #D4CBBE;
    background-color: #FFFFFF;
    color: #2C2A26;
    min-height: 20px;
}
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #D4CBBE;
    background-color: #F5F0E8;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}
QDateEdit:hover, QComboBox:hover {
    border: 1px solid #B8AE9E;
}
QDateEdit:focus, QComboBox:focus {
    border: 1px solid #4A6741;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #D4CBBE;
    selection-background-color: #E8EDE4;
    selection-color: #2C2A26;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #EDE6D9;
}

#btn_apply, #btn_export {
    padding: 8px 16px;
    font-size: 13px;
    border-radius: 4px;
    background-color: #FFFFFF;
    color: #2C2A26;
    border: 1px solid #D4CBBE;
    min-height: 20px;
}
#btn_apply:hover, #btn_export:hover {
    border: 1px solid #4A6741;
    background-color: #F5F0E8;
}
#btn_apply:pressed, #btn_export:pressed {
    background-color: #EDE6D9;
}

QTabWidget::panel { border: none; background-color: #FFFFFF; }
QTabBar { background-color: #FFFFFF; border: none; }
QTabBar::tab { 
    height: 40px; 
    background-color: #FFFFFF; 
    color: #6B6560; 
    font-size: 12px; 
    font-weight: normal; 
    padding: 0px 30px; 
    border: none; 
    border-bottom: 2px solid transparent; 
    border-top: 1px solid #D4CBBE;
    text-align: center; 
}
QTabBar::tab:hover { color: #2C2A26; }
QTabBar::tab:selected { color: #2C2A26; font-weight: 600; border-bottom: 2px solid #4A6741; }</string>
